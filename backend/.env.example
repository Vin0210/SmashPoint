APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Base URL of the SPA (used in password-reset email links)
# FRONTEND_URL=http://localhost:5173

REMINDER_MINUTES_BEFORE=60
SEMAPHORE_KEY=
SEMAPHORE_SENDER=SmashPoint

# Secret for the external scheduler ping (cron-job.org)
CRON_KEY=

# Brevo HTTP email API (brevo.com) - optional. Set only if the host blocks SMTP.
BREVO_API_KEY=
# HTTP email API - set when the host blocks SMTP ports (sendgrid.com free = 100/day)
MAIL_API_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
BREVO_API_KEY=
