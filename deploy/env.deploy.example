APP_NAME=SmashPoint
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:
APP_URL=https:
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME        
DB_PORT=3306
DB_DATABASE=CHANGE-ME   
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=null
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SmashPoint

FRONTEND_URL=

REMINDER_MINUTES_BEFORE=60

SEMAPHORE_KEY=
SEMAPHORE_SENDER=SmashPoint

CRON_KEY=PASTE-THE-CRON-KEY-FROM-LOCAL-ENV

# Brevo HTTP email API (brevo.com) - optional. Set only if the host blocks SMTP.
BREVO_API_KEY=

# HTTP email API - set when the host blocks SMTP ports
MAIL_API_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
BREVO_API_KEY=
