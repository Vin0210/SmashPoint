APP_NAME=SmashPoint
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE-WITH-php-artisan-key-generate
APP_URL=https://YOUR-DOMAIN.free-host.example

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME          # from hosting panel, e.g. sql123.great-site.net
DB_PORT=3306
DB_DATABASE=CHANGE-ME      # e.g. if0_12345_pickleball
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

REDIS_HOST=null
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=elvinramos454@gmail.com
MAIL_PASSWORD=YOUR-GMAIL-APP-PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=elvinramos454@gmail.com
MAIL_FROM_NAME=SmashPoint

FRONTEND_URL=https://YOUR-DOMAIN.free-host.example

REMINDER_MINUTES_BEFORE=60

SEMAPHORE_KEY=
SEMAPHORE_SENDER=SmashPoint

CRON_KEY=PASTE-THE-CRON-KEY-FROM-LOCAL-ENV

# Brevo HTTP email API (brevo.com) - optional. Set only if the host blocks SMTP.
BREVO_API_KEY=

# HTTP email API - set when the host blocks SMTP ports
MAIL_API_PROVIDER=sendgrid
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
BREVO_API_KEY=
